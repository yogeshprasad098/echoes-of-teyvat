[sub_resource type="Shader" id="Shader_igy2u"]
code = "shader_type canvas_item;
render_mode blend_mix;
uniform float distortion_strength : hint_range(0.0, 0.05) = 0.006;
uniform float scroll_speed : hint_range(0.0, 2.0) = 0.55;
void fragment() {
	vec2 sample_uv = UV;
	float dx = sin(sample_uv.y * 22.0 + TIME * scroll_speed) * distortion_strength;
	float dy = cos(sample_uv.x * 15.0 + TIME * scroll_speed * 0.7) * distortion_strength * 0.4;
	COLOR = texture(TEXTURE, sample_uv + vec2(dx, dy));
}"

